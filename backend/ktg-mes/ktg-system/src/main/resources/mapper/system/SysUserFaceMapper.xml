<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ktg.system.mapper.SysUserFaceMapper">

    <resultMap type="SysUserFace" id="SysUserFaceResult">
        <id     property="userId"     column="user_id"     />
        <result property="descriptor" column="descriptor"  />
        <result property="algorithm"  column="algorithm"   />
        <result property="samples"    column="samples"     />
        <result property="quality"    column="quality"     />
        <result property="status"     column="status"      />
        <result property="createBy"   column="create_by"   />
        <result property="createTime" column="create_time" />
        <result property="updateBy"   column="update_by"   />
        <result property="updateTime" column="update_time" />
        <result property="remark"     column="remark"      />
    </resultMap>

    <sql id="selectSysUserFaceVo">
        select user_id, descriptor, algorithm, samples, quality, status,
               create_by, create_time, update_by, update_time, remark
        from sys_user_face
    </sql>

    <select id="selectByUserId" parameterType="Long" resultMap="SysUserFaceResult">
        <include refid="selectSysUserFaceVo"/>
        where user_id = #{userId}
    </select>

    <insert id="insertSysUserFace" parameterType="SysUserFace">
        insert into sys_user_face
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="descriptor != null">descriptor,</if>
            <if test="algorithm != null">algorithm,</if>
            <if test="samples != null">samples,</if>
            <if test="quality != null">quality,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="descriptor != null">#{descriptor},</if>
            <if test="algorithm != null">#{algorithm},</if>
            <if test="samples != null">#{samples},</if>
            <if test="quality != null">#{quality},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateSysUserFace" parameterType="SysUserFace">
        update sys_user_face
        <trim prefix="SET" suffixOverrides=",">
            <if test="descriptor != null">descriptor = #{descriptor},</if>
            <if test="algorithm != null">algorithm = #{algorithm},</if>
            <if test="samples != null">samples = #{samples},</if>
            <if test="quality != null">quality = #{quality},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where user_id = #{userId}
    </update>

    <delete id="deleteByUserId" parameterType="Long">
        delete from sys_user_face where user_id = #{userId}
    </delete>

</mapper>
