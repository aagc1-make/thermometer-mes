        </trim>
    </insert>

    <update id="updateWmSalesOrderLine" parameterType="WmSalesOrderLine">
        update wm_sales_order_line
        <trim prefix="SET" suffixOverrides=",">
            <if test="orderId != null">order_id = #{orderId},</if>
            <if test="itemId != null">item_id = #{itemId},</if>
            <if test="itemCode != null">item_code = #{itemCode},</if>
            <if test="itemName != null">item_name = #{itemName},</if>
            <if test="specification != null">specification = #{specification},</if>
            <if test="unitOfMeasure != null">unit_of_measure = #{unitOfMeasure},</if>
            <if test="unitName != null">unit_name = #{unitName},</if>
            <if test="quantity != null">quantity = #{quantity},</if>
            <if test="price != null">price = #{price},</if>
            <if test="amount != null">amount = #{amount},</if>
            <if test="quantityProduced != null">quantity_produced = #{quantityProduced},</if>
            <if test="quantityShipped != null">quantity_shipped = #{quantityShipped},</if>
            <if test="workorderId != null">workorder_id = #{workorderId},</if>
            <if test="workorderCode != null">workorder_code = #{workorderCode},</if>
            <if test="oqcId != null">oqc_id = #{oqcId},</if>
            <if test="oqcCode != null">oqc_code = #{oqcCode},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="attr1 != null">attr1 = #{attr1},</if>
            <if test="attr2 != null">attr2 = #{attr2},</if>
            <if test="attr3 != null">attr3 = #{attr3},</if>
            <if test="attr4 != null">attr4 = #{attr4},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where line_id = #{lineId}
    </update>

    <delete id="deleteWmSalesOrderLineByOrderId" parameterType="Long">
        delete from wm_sales_order_line where order_id = #{orderId}
    </delete>

    <delete id="deleteWmSalesOrderLineByLineIds" parameterType="Long">
        delete from wm_sales_order_line where line_id in
        <foreach item="lineId" collection="array" open="(" separator="," close=")">
            #{lineId}
        </foreach>
    </delete>
    <update id="refreshShippedForNotice">
        update wm_sales_order_line ol join wm_sales_order o on o.order_id=ol.order_id
        set ol.quantity_shipped=coalesce((
            select sum(sl.quantity_sales)
            from wm_product_sales_line sl join wm_product_sales h on h.sales_id=sl.sales_id
            join wm_sales_notice_line n on n.notice_id=h.notice_id
              and sl.attr1=concat('AUTO:SALES_LINE:NOTICE:',n.line_id) and n.attr3=ol.line_id
            where h.status='FINISHED' and h.notice_id=#{noticeId} and sl.workorder_id=ol.workorder_id
        ),0)
        where o.notice_id=#{noticeId}
    </update>
</mapper>
