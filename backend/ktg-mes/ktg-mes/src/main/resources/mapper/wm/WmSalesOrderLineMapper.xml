    <sql id="selectWmSalesOrderLineVo">
        select line_id, order_id, item_id, item_code, item_name, specification, unit_of_measure, unit_name,
               quantity, price, amount, quantity_produced, quantity_shipped,
               workorder_id, workorder_code, oqc_id, oqc_code,
               status, remark, attr1, attr2, attr3, attr4,
               create_by, create_time, update_by, update_time
        from wm_sales_order_line
    </sql>

    <select id="selectWmSalesOrderLineList" parameterType="WmSalesOrderLine" resultMap="WmSalesOrderLineResult">
        <include refid="selectWmSalesOrderLineVo"/>
        <where>
            <if test="orderId != null"> and order_id = #{orderId}</if>
            <if test="itemId != null"> and item_id = #{itemId}</if>
            <if test="workorderId != null"> and workorder_id = #{workorderId}</if>
            <if test="status != null and status != ''"> and status = #{status}</if>
        </where>
        order by line_id asc
    </select>

    <select id="selectWmSalesOrderLineByLineId" parameterType="Long" resultMap="WmSalesOrderLineResult">
        <include refid="selectWmSalesOrderLineVo"/>
        where line_id = #{lineId}
    </select>

    <insert id="insertWmSalesOrderLine" parameterType="WmSalesOrderLine" useGeneratedKeys="true" keyProperty="lineId">
        insert into wm_sales_order_line
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="orderId != null">order_id,</if>
            <if test="itemId != null">item_id,</if>
            <if test="itemCode != null">item_code,</if>
            <if test="itemName != null">item_name,</if>
            <if test="specification != null">specification,</if>
            <if test="unitOfMeasure != null">unit_of_measure,</if>
            <if test="unitName != null">unit_name,</if>
            <if test="quantity != null">quantity,</if>
            <if test="price != null">price,</if>
            <if test="amount != null">amount,</if>
            <if test="quantityProduced != null">quantity_produced,</if>
            <if test="quantityShipped != null">quantity_shipped,</if>
            <if test="workorderId != null">workorder_id,</if>
            <if test="workorderCode != null">workorder_code,</if>
            <if test="oqcId != null">oqc_id,</if>
            <if test="oqcCode != null">oqc_code,</if>
            <if test="status != null">status,</if>
            <if test="remark != null">remark,</if>
            <if test="attr1 != null">attr1,</if>
            <if test="attr2 != null">attr2,</if>
            <if test="attr3 != null">attr3,</if>
            <if test="attr4 != null">attr4,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="orderId != null">#{orderId},</if>
            <if test="itemId != null">#{itemId},</if>
            <if test="itemCode != null">#{itemCode},</if>
            <if test="itemName != null">#{itemName},</if>
            <if test="specification != null">#{specification},</if>
            <if test="unitOfMeasure != null">#{unitOfMeasure},</if>
            <if test="unitName != null">#{unitName},</if>
            <if test="quantity != null">#{quantity},</if>
            <if test="price != null">#{price},</if>
            <if test="amount != null">#{amount},</if>
            <if test="quantityProduced != null">#{quantityProduced},</if>
            <if test="quantityShipped != null">#{quantityShipped},</if>
            <if test="workorderId != null">#{workorderId},</if>
            <if test="workorderCode != null">#{workorderCode},</if>
            <if test="oqcId != null">#{oqcId},</if>
            <if test="oqcCode != null">#{oqcCode},</if>
            <if test="status != null">#{status},</if>
            <if test="remark != null">#{remark},</if>
            <if test="attr1 != null">#{attr1},</if>
            <if test="attr2 != null">#{attr2},</if>
            <if test="attr3 != null">#{attr3},</if>
            <if test="attr4 != null">#{attr4},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
