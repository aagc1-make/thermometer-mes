<mapper namespace="com.ktg.mes.wm.mapper.WmSalesOrderLineMapper">

    <resultMap type="WmSalesOrderLine" id="WmSalesOrderLineResult">
        <result property="lineId"           column="line_id"           />
        <result property="orderId"          column="order_id"          />
        <result property="itemId"           column="item_id"           />
        <result property="itemCode"         column="item_code"         />
        <result property="itemName"         column="item_name"         />
        <result property="specification"    column="specification"     />
        <result property="unitOfMeasure"    column="unit_of_measure"   />
        <result property="unitName"         column="unit_name"         />
        <result property="quantity"         column="quantity"          />
        <result property="price"            column="price"             />
        <result property="amount"           column="amount"            />
        <result property="quantityProduced" column="quantity_produced" />
        <result property="quantityShipped"  column="quantity_shipped"  />
        <result property="workorderId"      column="workorder_id"      />
        <result property="workorderCode"    column="workorder_code"    />
        <result property="oqcId"            column="oqc_id"            />
        <result property="oqcCode"          column="oqc_code"          />
        <result property="status"           column="status"            />
        <result property="remark"           column="remark"            />
        <result property="attr1"            column="attr1"             />
        <result property="attr2"            column="attr2"             />
