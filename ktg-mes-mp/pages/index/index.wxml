<view class="page">

  <!-- 搜索 -->
  <view class="search">
    <text class="search__placeholder" wx:if="{{!keyword}}">搜索产品名称 / 编码</text>
    <input class="search__input" value="{{keyword}}" bindinput="onKeyword" placeholder="搜索产品名称 / 编码" placeholder-class="search__placeholder" />
  </view>

  <!-- 主 Banner -->
  <view class="banner">
    <view class="banner__tag">IRG 系列 · 企业批量订购</view>
    <view class="banner__title">成品与半成品\n批量订购通道</view>
    <view class="banner__desc">下单前可先发起询价，销售 2 小时内响应对接</view>
    <view class="banner__btn" bindtap="goInquiry">发起询价</view>
  </view>

  <!-- 四宫格 -->
  <view class="grid">
    <view class="grid__item" wx:for="{{quick}}" wx:key="key" data-key="{{item.key}}" bindtap="onQuick">
      <view class="grid__icon" style="background:{{item.bg}}">{{item.icon}}</view>
      <view class="grid__text">{{item.text}}</view>
    </view>
  </view>

  <!-- 可订购产品 -->
  <view class="section-title">可订购产品</view>
  <view class="tabs">
    <view class="tabs__item {{category === item ? 'is-active' : ''}}" wx:for="{{categories}}" wx:key="*this" data-c="{{item}}" bindtap="onCategory">{{item}}</view>
  </view>

  <view class="plist">
    <view class="pcard" wx:for="{{products}}" wx:key="itemCode">
      <view class="pcard__head">
        <text class="tag {{item.itemType === '成品' ? 'tag--fg' : 'tag--sf'}}">{{item.itemType}}</text>
        <text class="pcard__name">{{item.itemName}}</text>
      </view>
      <view class="t-code">{{item.itemCode}}</view>
      <view class="pcard__spec">{{item.specification}}</view>
      <view class="pcard__foot">
        <view>
          <text class="t-price">¥{{item.refPrice}}</text>
          <text class="t-sub"> / {{item.unitName}} · 起订 {{item.minOrderQty}}</text>
        </view>
        <view class="btn btn--primary btn--sm" data-i="{{index}}" bindtap="addCart">加入询价</view>
      </view>
    </view>
  </view>

  <!-- 大批量采购 -->
  <view class="bulk">
    <view>
      <view class="bulk__title">大批量采购需求？</view>
      <view class="bulk__sub">500 台以上可申请专属价格与排产优先</view>
    </view>
    <view class="btn btn--ghost btn--sm">联系销售</view>
  </view>

</view>
