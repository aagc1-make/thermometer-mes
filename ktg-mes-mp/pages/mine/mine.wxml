<view class="page">
  <!-- 企业信息头部 -->
  <view class="hero">
    <view class="hero__company">{{me.company}}</view>
    <view class="hero__row">
      <text class="hero__tag">企业认证</text>
      <text class="hero__contact">采购员：{{me.contact}}</text>
    </view>
  </view>

  <!-- 数据卡 -->
  <view class="stats">
    <view class="stats__item">
      <view class="stats__num">{{me.stat.inquiring}}</view>
      <view class="stats__label">询价中</view>
    </view>
    <view class="stats__item">
      <view class="stats__num">{{me.stat.waiting}}</view>
      <view class="stats__label">待确认</view>
    </view>
    <view class="stats__item">
      <view class="stats__num">{{me.stat.dealed}}</view>
      <view class="stats__label">已成交</view>
    </view>
  </view>

  <!-- 我的订单 -->
  <view class="section-title">我的订单</view>
  <view class="card">
    <view class="orders">
      <view class="orders__item" wx:for="{{orders}}" wx:key="key">
        <view class="orders__num">{{item.num}}</view>
        <view class="orders__label">{{item.label}}</view>
      </view>
    </view>
  </view>

  <!-- 常用服务 -->
  <view class="section-title">常用服务</view>
  <view class="card">
    <view class="grid">
      <view class="grid__item" wx:for="{{services}}" wx:key="key">
        <view class="grid__icon" style="background:{{item.bg}}">{{item.icon}}</view>
        <view class="grid__text">{{item.text}}</view>
      </view>
    </view>
  </view>

  <!-- 企业信息 -->
  <view class="section-title">企业信息</view>
  <view class="card">
    <view class="kv"><text class="kv__k">统一社会信用代码</text><text class="kv__v">{{me.creditCode}}</text></view>
    <view class="kv"><text class="kv__k">客户等级</text><text class="kv__v">{{me.level}}</text></view>
    <view class="kv"><text class="kv__k">专属销售</text><text class="kv__v">{{me.sales}} · {{me.phone}}</text></view>
  </view>

  <view class="ver">红外测温枪 MES · 企业订购小程序 v1.0</view>
</view>
