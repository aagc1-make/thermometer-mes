.hero {
  padding: 36rpx 32rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #4E86FF 0%, #2A5FE0 100%);
  color: #fff;
  box-shadow: 0 20rpx 56rpx rgba(42, 95, 224, 0.25);
}

.hero__company {
  font-size: 34rpx;
  font-weight: 800;
}

.hero__row {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.hero__tag {
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.2);
  font-size: 20rpx;
}

.hero__contact {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

.stats {
  margin-top: 22rpx;
  display: flex;
  background: #fff;
  border-radius: 36rpx;
  padding: 28rpx 0;
  box-shadow: 0 20rpx 56rpx rgba(31, 74, 150, 0.07);
}

.stats__item {
  flex: 1;
  text-align: center;
}

.stats__num {
  font-size: 38rpx;
  font-weight: 800;
  color: #2F6BEF;
}

.stats__label {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #6E7E96;
}

.orders {
  display: flex;
}

.orders__item {
  flex: 1;
  text-align: center;
}

.orders__num {
  font-size: 32rpx;
  font-weight: 800;
  color: #16233B;
}

.orders__label {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #6E7E96;
}

.grid {
  display: flex;
  flex-wrap: wrap;
}

.grid__item {
  width: 33.33%;
  text-align: center;
  padding: 18rpx 0;
}

.grid__icon {
  width: 80rpx;
  height: 80rpx;
  margin: 0 auto 10rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 800;
  color: #2F6BEF;
}

.grid__text {
  font-size: 21rpx;
  color: #6E7E96;
}

.kv {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
}

.kv__k {
  font-size: 23rpx;
  color: #6E7E96;
}

.kv__v {
  font-size: 23rpx;
  color: #16233B;
  font-weight: 600;
}

.ver {
  margin: 40rpx 0 20rpx;
  text-align: center;
  font-size: 20rpx;
  color: #96A5BA;
}
